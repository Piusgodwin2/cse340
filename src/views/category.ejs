<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= categoryDetails.name %></h2>

    <a href="/edit-category/<%= categoryDetails.category_id %>">Edit Category</a>

    <h3>Service Projects</h3>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>"><%= project.name %></a>
            </li>
        <% }) %>
    </ul>
</main>
<%- include('partials/footer') %>